{
  "name": "blox-studio-server",
  "private": true,
  "type": "module",
  "description": "Runs the Blox Studio server (projects, AI link, Roblox publishing) outside Bit, for free hosts like Render.",
  "scripts": {
    "build": "esbuild serve.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --external:express --external:mongoose --alias:@nikethbhat4thh/blox-studio.rbxlx-serializer=../blox-studio/rbxlx-serializer/index.ts",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "esbuild": "0.27.7",
    "express": "5.3.0",
    "mongoose": "9.11.4"
  },
  "engines": { "node": ">=20" }
}
