ts = Instance.new(\"Folder\")\n\tstats.Name = \"leaderstats\"\n\tstats.Parent = player\n\tlocal stage = Instance.new(\"IntValue\")\n\tstage.Name = \"Stage\"\n\tstage.Value = 1\n\tstage.Parent = stats\n\n\tlocal s = { stage = stage, checkpoint = nil, startedAt = os.clock(), finished = false }\n\tstate[player] = s\n\n\t-- After dying, start again from the last checkpoint.\n\tplayer.CharacterAdded:Connect(function(character)\n\t\tif s.checkpoint then\n\t\t\tcharacter.HumanoidRootPart.CFrame = CFrame.new(s.checkpoint.X, s.checkpoint.Y, s.checkpoint.Z)\n\t\tend\n\tend)\nend)\n\nlocal function playerFrom(hit)\n\treturn Players:GetPlayerFromCharacter(hit.Parent)\nend\n\nfor _, part in ipairs(workspace:GetDescendants()) do\n\tlocal behavior = part:GetAttribute(\"Behavior\")\n\n\tif behavior == \"kill\" then\n\t\tpart.Touched:Connect(function(hit)\n\t\t\tlocal humanoid = hit.Parent:FindFirstChildOfClass(\"Humanoid\")\n\t\t\tif humanoid then humanoid.Health = 0 end\n\t\tend)\n\n\telseif behavior == \"checkpoint\" then\n\t\tlocal number = part:GetAttribute(\"Checkpoint\") or 2\n\t\tpart.Touched:Connect(function(hit)\n\t\t\tlocal player = playerFrom(hit)\n\t\t\tlocal s = player and state[player]\n\t\t\tif s and number > s.stage.Value then\n\t\t\t\ts.stage.Value = number\n\t\t\t\ts.checkpoint = Vector3.new(part.Position.X, part.Position.Y + part.Size.Y / 2 + 2.7, part.Position.Z)\n\t\t\t\tnotify:FireClient(player, \"Checkpoint!\", \"Stage \" .. number)\n\t\t\tend\n\t\tend)\n\n\telseif behavior == \"finish\" then\n\t\tpart.Touched:Connect(function(hit)\n\t\t\tlocal player = playerFrom(hit)\n\t\t\tlocal s = player and state[player]\n\t\t\tif s and not s.finished then\n\t\t\t\ts.finished = true\n\t\t\t\tnotify:FireClient(player, \"You beat the obby!\", string.format(\"Time: %.1f seconds\", os.clock() - s.startedAt))\n\t\t\tend\n\t\tend)\n\n\telseif behavior == \"jumpPad\" then\n\t\tlocal power = part:GetAttribute(\"JumpPower\") or 100\n\t\tlocal lastBounce = 0\n\t\tpart.Touched:Connect(function(hit)\n\t\t\tif os.clock() - lastBounce < JUMP_PAD_COOLDOWN then return end\n\t\t\tlastBounce = os.clock()\n\t\t\thit.AssemblyLinearVelocity = Vector3.new(0, power, 0)\n\t\tend)\n\tend\nend\n"}},{"id":"gicnw36eef03","className":"LocalScript","name":"ObbyClient","parentId":"StarterPlayerScripts","props":{"source":"-- ObbyClient: runs on the player's device and shows the messages ObbyRules sends.\nif workspace:GetAttribute(\"ScriptedGameplay\") ~= true then return end\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal StarterGui = game:GetService(\"StarterGui\")\n\nlocal notify = ReplicatedStorage:WaitForChild(\"Notify\")\nnotify.OnClientEvent:Connect(function(title, text)\n\tStarterGui:SetCore(\"SendNotification\", { Title = title, Text = text, Duration = 4 })\nend)\n"}},{"id":"z7rl5whcef03","className":"Script","name":"Main","parentId":"ServerScriptService","props":{"source":"-- Your own server code goes here.\n-- The course rules (kill bricks, checkpoints, finish, jump pads) are in ObbyRules.\nprint(\"Welcome to Sky Islands Obby!\")\n"}}]